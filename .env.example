# Public Firebase web app configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Server-only Firebase Admin service account
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Server-only Google AI Studio key; use a model available to your project
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Server-only Mistral tutor; Gemini remains OCR + study generation
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# Dedicated Oracle schema and full TCPS descriptor, not a TNS alias
ORACLE_USER=NOTELAB
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=
# ewallet.pem in base64; wallet password differs from database password
ORACLE_WALLET_PEM_BASE64=
ORACLE_WALLET_PASSWORD=
AI_DAILY_LIMIT=40
