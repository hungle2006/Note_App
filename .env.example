# Public Firebase web app configuration
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Server-only Firebase Admin service account
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Server-only Google AI Studio key; use a model available to your project
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Server-only Groq tutor; Gemini remains OCR + study generation
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Turso libSQL database URL (not the dashboard URL); server-only write token
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Shared daily Gemini + Groq request limit per Firebase UID (UTC reset)
AI_DAILY_LIMIT=40

# Optional server-only Hugging Face read token for VietScribe (public Space works without it)
VIETSCRIBE_HF_TOKEN=
