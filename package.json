{
  "name": "notelab",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate.mjs",
    "db:check": "node --env-file=.env.local --import tsx scripts/check-db.mjs"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "firebase": "12.19.0",
    "firebase-admin": "14.5.0",
    "katex": "0.16.22",
    "lucide-react": "0.468.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/node": "22.19.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22 <25"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.0",
    "gaxios": {
      "uuid": "^11.1.1"
    }
  }
}
